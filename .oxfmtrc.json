{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "trailingComma": "es5",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "avoid",
  "sortPackageJson": false,
  "sortImports": {
    "groups": [
      "builtin",
      "external",
      "internal",
      ["sibling", "parent"],
      "index",
      "unknown"
    ],
    "newlinesBetween": true,
    "order": "asc",
    "ignoreCase": true
  },
  "ignorePatterns": [
    "pnpm-lock.yaml",
    "packages/node/src/api-links/__tests__/fixtures/",
    "*.snapshot",
    "packages/react/src/html/template.html",
    "out/",
    "www/content/",
    "www/out/",
    "packages/core/src/generators/metadata/maps/mdn.json",
    "packages/core/src/generators/json/generated/",
    "docs/specification.md"
  ],
  "overrides": [
    {
      "files": ["www/pages/**/*.md"],
      "options": {
        "proseWrap": "always"
      }
    }
  ]
}
