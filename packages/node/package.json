{
  "name": "@node-core/doc-kit",
  "type": "module",
  "version": "2.0.8",
  "description": "Node.js-specific generators for @doc-kit/core: api-links, addon-verify, html-all, and man-page",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nodejs/doc-kit.git",
    "directory": "packages/node"
  },
  "license": "MIT",
  "exports": {
    "./addon-verify": "./src/addon-verify/index.mjs",
    "./api-links": "./src/api-links/index.mjs",
    "./config": "./src/config/index.mjs",
    "./html-all": "./src/html-all/index.mjs",
    "./man-page": "./src/man-page/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "!src/**/*.test.mjs",
    "!src/**/__tests__",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "@doc-kit/core": "workspace:*",
    "estree-util-visit": "^2.0.0",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@doc-kit/generator-react": "workspace:*",
    "unist-builder": "^4.0.0"
  },
  "peerDependencies": {
    "@doc-kit/generator-react": "workspace:>=0.1.0"
  },
  "peerDependenciesMeta": {
    "@doc-kit/generator-react": {
      "optional": true
    }
  }
}
