{
  "name": "@doc-kit/cli",
  "type": "module",
  "version": "1.0.2",
  "description": "The doc-kit command-line interface: runs @doc-kit/core generators from the terminal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nodejs/doc-kit.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "scripts": {
    "run": "node bin/cli.mjs",
    "watch": "node --watch bin/cli.mjs"
  },
  "bin": {
    "doc-kit": "./bin/cli.mjs"
  },
  "files": [
    "bin",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "@doc-kit/core": "workspace:*",
    "commander": "^15.0.0"
  }
}
